<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="warning"/>

    <!-- Report UTF-8 encoding issues -->
    <module name="FileTextCheck"/>

    <module name="TreeWalker">
        <!-- Common basic checks -->
        <module name="UnusedImports"/>
        <module name="NeedBraces"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_CATCH, LITERAL_FINALLY, LITERAL_TRY, LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE, STATIC_INIT, INSTANCE_INIT, LITERAL_SWITCH"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround"/>
        <module name="NoLineWrap"/>
        <module name="OneStatementPerLine"/>

        <!-- Limit line length but ignore imports and package lines -->
        <module name="LineLength">
            <property name="max" value="140"/>
            <property name="ignorePattern" value="^package\\s+.*|^import\\s+.*"/>
        </module>
    </module>
</module>
